From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Wed, 15 Jan 2025 06:45:00 +0000
Subject: [PATCH] mt7988: use UART2 for TF-A console and crash console

Switch the TF-A console on MT7988 from UART0 to UART2 to align with
the BPI-R4 serial header wiring and U-Boot's console setup.

Signed-off-by: Codex <codex@openai.com>
---
 plat/mediatek/mt7988/aarch64/plat_helpers.S | 6 +++---
 plat/mediatek/mt7988/include/mt7988_def.h   | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

--- a/plat/mediatek/mt7988/aarch64/plat_helpers.S
+++ b/plat/mediatek/mt7988/aarch64/plat_helpers.S
@@ -84,5 +84,5 @@ endfunc plat_my_core_pos
 func plat_crash_console_init
-	mov_imm	x0, UART0_BASE
+	mov_imm	x0, UART2_BASE
 	mov_imm	x1, UART_CLOCK
 	mov_imm	x2, UART_BAUDRATE
 	mov_imm	x3, 1
@@ -99,6 +99,6 @@ endfunc plat_crash_console_init
  * ---------------------------------------------
  */
 func plat_crash_console_putc
-	mov_imm x1, UART0_BASE
+	mov_imm x1, UART2_BASE
 	b	console_hsuart_core_putc
 endfunc plat_crash_console_putc
@@ -115,1 +115,1 @@ func plat_crash_console_flush
-	mov_imm	x0, UART0_BASE
+	mov_imm	x0, UART2_BASE
--- a/plat/mediatek/mt7988/include/mt7988_def.h
+++ b/plat/mediatek/mt7988/include/mt7988_def.h
@@ -46,7 +46,7 @@
 /* UART */
-#define UART_BASE			UART0_BASE
+#define UART_BASE			UART2_BASE
 #define UART_BAUDRATE			115200
 #define UART_CLOCK			40000000
