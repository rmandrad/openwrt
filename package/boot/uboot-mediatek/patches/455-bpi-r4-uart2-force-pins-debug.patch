From 1b2c3d4e5f60718293a4b5c6d7e8f90123456789 Mon Sep 17 00:00:00 2001
From: Rudy Andram <rmandrad@gmail.com>
Date: Sat, 18 Jan 2026 12:05:00 +0000
Subject: [PATCH] uboot: serial_mtk: force UART2 pins and add RX/pinmux debug polling

Issue: U-Boot TX worked but RX was silent, with no visibility into pinmux/DI
state or LSR transitions.
Solution: add force-pins/debug-pins handling, force GPIO58/59 to uart2_3_lite,
set DIR to input, enable IES/SMT, log LSR/DI/MODE/DIR/HIGHS/SAMPLE_*, and
clear DMA/autobaud/sleep/escape/ratefix while reinitializing UART regs.

Signed-off-by: Rudy Andram <rmandrad@gmail.com>
--- a/drivers/serial/serial_mtk.c
+++ b/drivers/serial/serial_mtk.c
@@ -15,6 +15,7 @@
 #include <errno.h>
 #include <log.h>
 #include <serial.h>
+#include <time.h>
 #include <watchdog.h>
 #include <asm/global_data.h>
 #include <asm/io.h>
@@ -76,6 +77,19 @@
 		     UART_FCR_RXSR |	\
 		     UART_FCR_TXSR)
 
+#define MT7988_UART2_BASE	0x11000200
+#define MT7988_GPIO_BASE	0x1001f000
+#define MT7988_GPIO_MODE_7	0x370
+#define MT7988_GPIO_DI0		0x200
+#define MT7988_GPIO_DI		0x210
+#define MT7988_GPIO_DI2		0x220
+#define MT7988_GPIO_DIR		0x010
+#define MT7988_IOCFG_TR_BASE	0x11c10000
+#define MT7988_IOCFG_TL_BASE	0x11f00000
+#define MT7988_IOCFG_TR_IES	0x40
+#define MT7988_IOCFG_TR_SMT	0xe0
+#define MT7988_IOCFG_TR_PUPD	0x60
+
 /* the data is correct if the real baud is within 3%. */
 #define BAUD_ALLOW_MAX(baud)	((baud) + (baud) * 3 / 100)
 #define BAUD_ALLOW_MIX(baud)	((baud) - (baud) * 3 / 100)
@@ -97,6 +111,16 @@
 	u32 fixed_clk_rate;
 	bool force_highspeed;
 	bool upstream_highspeed_logic;
+	fdt_addr_t base;
+	bool force_pins;
+	bool debug_pins;
+	u8 last_lsr;
+	u32 last_gpio_mode;
+	u32 last_di0;
+	u32 last_di1;
+	u32 last_di2;
+	bool last_valid;
+	ulong last_poll_ms;
 };
 
 static const unsigned short fraction_l_mapping[] = {
@@ -210,6 +234,188 @@
 }
 
 #if CONFIG_IS_ENABLED(DM_SERIAL)
+static bool mtk_serial_is_uart2(struct mtk_serial_priv *priv)
+{
+	return priv->base == MT7988_UART2_BASE;
+}
+
+static void mtk_serial_set_iocfg_ies_smt(u32 base)
+{
+	u32 val;
+
+	val = readl((void *)(uintptr_t)(base + MT7988_IOCFG_TR_IES));
+	val |= (1U << 4) | (1U << 5);
+	writel(val, (void *)(uintptr_t)(base + MT7988_IOCFG_TR_IES));
+
+	val = readl((void *)(uintptr_t)(base + MT7988_IOCFG_TR_SMT));
+	val |= (1U << 4) | (1U << 5);
+	writel(val, (void *)(uintptr_t)(base + MT7988_IOCFG_TR_SMT));
+
+	val = readl((void *)(uintptr_t)(base + MT7988_IOCFG_TR_PUPD));
+	val &= ~((1U << 2) | (1U << 3));
+	writel(val, (void *)(uintptr_t)(base + MT7988_IOCFG_TR_PUPD));
+}
+
+static void mtk_serial_hw_init(struct mtk_serial_priv *priv)
+{
+	writel(0, &priv->regs->dma_en);
+	writel(0, &priv->regs->sleep_en);
+	writel(0, &priv->regs->escape_en);
+	writel(0, &priv->regs->autobaud_en);
+	writel(0, &priv->regs->autobaud_reg);
+	writel(0, &priv->regs->autobaud_sample);
+	writel(0, &priv->regs->ratefix_ad);
+
+	writel(UART_LCR_WLS_8, &priv->regs->lcr);
+	writel(UART_MCRVAL, &priv->regs->mcr);
+	writel(UART_FCRVAL, &priv->regs->fcr);
+}
+
+static void mtk_serial_force_pins(struct udevice *dev,
+			  struct mtk_serial_priv *priv)
+{
+	u32 val;
+
+	if (!mtk_serial_is_uart2(priv))
+		return;
+
+	if (!priv->force_pins) {
+		if (priv->debug_pins)
+			printf("uart2 pins not forced (pinctrl)\n");
+		return;
+	}
+
+	val = readl((void *)(uintptr_t)(MT7988_GPIO_BASE + MT7988_GPIO_MODE_7));
+	val &= ~((0xf << 8) | (0xf << 12));
+	val |= (3 << 8) | (3 << 12);
+	writel(val, (void *)(uintptr_t)(MT7988_GPIO_BASE + MT7988_GPIO_MODE_7));
+
+	val = readl((void *)(uintptr_t)(MT7988_GPIO_BASE + MT7988_GPIO_DIR));
+	val &= ~((1U << 26) | (1U << 27));
+	writel(val, (void *)(uintptr_t)(MT7988_GPIO_BASE + MT7988_GPIO_DIR));
+
+	mtk_serial_set_iocfg_ies_smt(MT7988_IOCFG_TR_BASE);
+	if (priv->debug_pins)
+		mtk_serial_set_iocfg_ies_smt(MT7988_IOCFG_TL_BASE);
+
+	if (priv->debug_pins)
+		printf("uart2 pins forced to uart2_3_lite\n");
+}
+
+static void mtk_serial_debug_poll(struct udevice *dev,
+			  struct mtk_serial_priv *priv)
+{
+	u8 lsr;
+	u32 mode;
+	u32 di0;
+	u32 di1;
+	u32 di2;
+	u32 dir;
+	u32 ies_tr;
+	u32 smt_tr;
+	u32 pupd_tr;
+	u32 ies_tl;
+	u32 smt_tl;
+	u32 pupd_tl;
+	u32 highspeed;
+	u32 sample_count;
+	u32 sample_point;
+	u32 ratefix;
+	u32 chg0 = 0;
+	u32 chg1 = 0;
+	u32 chg2 = 0;
+	u32 iir;
+	u32 lcr;
+	u32 mcr;
+	u32 msr;
+	u32 scr;
+	u32 rbr = 0;
+	u8 prev_lsr;
+	u8 di58;
+	u8 di59;
+	u8 last_di58;
+	u8 last_di59;
+	bool di_fall;
+	bool changed;
+
+	if (!mtk_serial_is_uart2(priv))
+		return;
+
+	if (priv->last_poll_ms && get_timer(priv->last_poll_ms) < 100)
+		return;
+	priv->last_poll_ms = get_timer(0);
+
+	lsr = readl(&priv->regs->lsr);
+	mode = readl((void *)(uintptr_t)(MT7988_GPIO_BASE + MT7988_GPIO_MODE_7));
+	di0 = readl((void *)(uintptr_t)(MT7988_GPIO_BASE + MT7988_GPIO_DI0));
+	di1 = readl((void *)(uintptr_t)(MT7988_GPIO_BASE + MT7988_GPIO_DI));
+	di2 = readl((void *)(uintptr_t)(MT7988_GPIO_BASE + MT7988_GPIO_DI2));
+	dir = readl((void *)(uintptr_t)(MT7988_GPIO_BASE + MT7988_GPIO_DIR));
+	highspeed = readl(&priv->regs->highspeed);
+	sample_count = readl(&priv->regs->sample_count);
+	sample_point = readl(&priv->regs->sample_point);
+	ratefix = readl(&priv->regs->ratefix_ad);
+	ies_tr = readl((void *)(uintptr_t)(MT7988_IOCFG_TR_BASE + MT7988_IOCFG_TR_IES));
+	smt_tr = readl((void *)(uintptr_t)(MT7988_IOCFG_TR_BASE + MT7988_IOCFG_TR_SMT));
+	pupd_tr = readl((void *)(uintptr_t)(MT7988_IOCFG_TR_BASE + MT7988_IOCFG_TR_PUPD));
+	ies_tl = readl((void *)(uintptr_t)(MT7988_IOCFG_TL_BASE + MT7988_IOCFG_TR_IES));
+	smt_tl = readl((void *)(uintptr_t)(MT7988_IOCFG_TL_BASE + MT7988_IOCFG_TR_SMT));
+	pupd_tl = readl((void *)(uintptr_t)(MT7988_IOCFG_TL_BASE + MT7988_IOCFG_TR_PUPD));
+
+	if (priv->last_valid) {
+		chg0 = di0 ^ priv->last_di0;
+		chg1 = di1 ^ priv->last_di1;
+		chg2 = di2 ^ priv->last_di2;
+	}
+
+	di58 = (di1 >> 26) & 1;
+	di59 = (di1 >> 27) & 1;
+	last_di58 = priv->last_valid ? ((priv->last_di1 >> 26) & 1) : di58;
+	last_di59 = priv->last_valid ? ((priv->last_di1 >> 27) & 1) : di59;
+	di_fall = priv->last_valid &&
+		  ((last_di58 && !di58) || (last_di59 && !di59));
+
+	changed = !priv->last_valid ||
+		  lsr != priv->last_lsr ||
+		  mode != priv->last_gpio_mode ||
+		  chg0 || chg1 || chg2;
+	if (!changed)
+		return;
+
+	prev_lsr = priv->last_valid ? priv->last_lsr : lsr;
+	printf("uart2 LSR %#x -> %#x DI58=%u DI59=%u DIchg0=%#x DIchg1=%#x DIchg2=%#x MODE=0x%08x M58=%u M59=%u DIR=0x%08x D58=%u D59=%u IES=%u/%u SMT=%u/%u PUPD=%u/%u IES_TL=%u/%u SMT_TL=%u/%u PUPD_TL=%u/%u HIGHS=%#x SAMPLE_COUNT=%#x SAMPLE_POINT=%#x RATEFIX=%#x\n",
+	       prev_lsr, lsr, di58, di59, chg0, chg1, chg2, mode,
+	       (mode >> 8) & 0xf, (mode >> 12) & 0xf, dir,
+	       (dir >> 26) & 1, (dir >> 27) & 1,
+	       (ies_tr >> 4) & 1, (ies_tr >> 5) & 1,
+	       (smt_tr >> 4) & 1, (smt_tr >> 5) & 1,
+	       (pupd_tr >> 2) & 1, (pupd_tr >> 3) & 1,
+	       (ies_tl >> 4) & 1, (ies_tl >> 5) & 1,
+	       (smt_tl >> 4) & 1, (smt_tl >> 5) & 1,
+	       (pupd_tl >> 2) & 1, (pupd_tl >> 3) & 1,
+	       highspeed, sample_count, sample_point, ratefix);
+
+	if (di_fall) {
+		iir = readl(&priv->regs->iir);
+		lcr = readl(&priv->regs->lcr);
+		mcr = readl(&priv->regs->mcr);
+		msr = readl(&priv->regs->msr);
+		scr = readl(&priv->regs->scr);
+		if (lsr & UART_LSR_DR)
+			rbr = readl(&priv->regs->rbr);
+		printf("uart2 edge: DI58 %u->%u DI59 %u->%u LSR=%#x IIR=%#x LCR=%#x MCR=%#x MSR=%#x SCR=%#x RBR=%#x\n",
+		       last_di58, di58, last_di59, di59, lsr,
+		       iir, lcr, mcr, msr, scr, rbr);
+	}
+
+	priv->last_lsr = lsr;
+	priv->last_gpio_mode = mode;
+	priv->last_di0 = di0;
+	priv->last_di1 = di1;
+	priv->last_di2 = di2;
+	priv->last_valid = true;
+}
+
 static int mtk_serial_setbrg(struct udevice *dev, int baudrate)
 {
 	struct mtk_serial_priv *priv = dev_get_priv(dev);
@@ -219,6 +419,10 @@
 	if (IS_ERR_VALUE(clk_rate) || clk_rate == 0)
 		clk_rate = priv->fixed_clk_rate;
 
+	if (priv->debug_pins)
+		printf("uart2 clk_rate=%u fixed=%u baud=%d\n", clk_rate,
+		       priv->fixed_clk_rate, baudrate);
+
 	_mtk_serial_setbrg(priv, baudrate, clk_rate);
 
 	return 0;
@@ -228,6 +432,9 @@
 {
 	struct mtk_serial_priv *priv = dev_get_priv(dev);
 
+	if (priv->debug_pins)
+		mtk_serial_debug_poll(dev, priv);
+
 	return _mtk_serial_putc(priv, ch);
 }
 
@@ -235,6 +442,9 @@
 {
 	struct mtk_serial_priv *priv = dev_get_priv(dev);
 
+	if (priv->debug_pins)
+		mtk_serial_debug_poll(dev, priv);
+
 	return _mtk_serial_getc(priv);
 }
 
@@ -242,6 +452,9 @@
 {
 	struct mtk_serial_priv *priv = dev_get_priv(dev);
 
+	if (input && priv->debug_pins)
+		mtk_serial_debug_poll(dev, priv);
+
 	return _mtk_serial_pending(priv, input);
 }
 
@@ -252,13 +465,16 @@
 	/* Disable interrupt */
 	writel(0, &priv->regs->ier);
 
-	writel(UART_MCRVAL, &priv->regs->mcr);
-	writel(UART_FCRVAL, &priv->regs->fcr);
-
 	clk_enable(&priv->clk);
 	if (priv->clk_bus.dev)
 		clk_enable(&priv->clk_bus);
 
+	mtk_serial_hw_init(priv);
+	mtk_serial_force_pins(dev, priv);
+	
+	if (priv->debug_pins)
+		mtk_serial_debug_poll(dev, priv);
+
 	return 0;
 }
 
@@ -272,6 +488,7 @@
 	if (addr == FDT_ADDR_T_NONE)
 		return -EINVAL;
 
+	priv->base = addr;
 	priv->regs = map_physmem(addr, 0, MAP_NOCACHE);
 
 	err = clk_get_by_index(dev, 0, &priv->clk);
@@ -292,6 +509,8 @@
 	clk_get_by_name(dev, "bus", &priv->clk_bus);
 
 	priv->force_highspeed = dev_read_bool(dev, "mediatek,force-highspeed");
+	priv->force_pins = dev_read_bool(dev, "mediatek,force-pins");
+	priv->debug_pins = dev_read_bool(dev, "mediatek,debug-pins");
 	priv->upstream_highspeed_logic =
 		device_is_compatible(dev, "mediatek,mt6577-uart");
 
